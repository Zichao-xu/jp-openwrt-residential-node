# Optional IPv6-only delta for openwrt/network.example.
# Apply only after the IPv4 tunnel has been validated.

config interface 'wg_exit'
	list addresses 'fd77:77:77::2/128'

config wireguard_wg_exit
	list allowed_ips 'fd77:77:77::1/128'

# Do not add ::/0 here unless the home gateway has a deliberate IPv6 policy route
# or the proxy core explicitly selects this outbound for IPv6 traffic.

config interface 'lan6'
	option proto 'dhcpv6'
	option ifname '@lan'
	option reqaddress 'try'
	option reqprefix 'no'
	option peerdns '1'
	option defaultroute '1'
	option sourcefilter '0'
	option metric '10'
