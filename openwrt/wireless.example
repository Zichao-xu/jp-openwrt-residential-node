config wifi-iface 'wifi_fallback_5g'
	option device 'radio0'
	option mode 'sta'
	option network 'wifiwan'
	option ssid '<FRIEND_WIFI_5G_SSID>'
	option encryption 'psk2'
	option key '<FRIEND_WIFI_PASSWORD>'
	option disabled '0'

config wifi-iface 'wifi_fallback_24g'
	option device 'radio1'
	option mode 'sta'
	option network 'wifiwan'
	option ssid '<FRIEND_WIFI_24G_SSID>'
	option encryption 'psk2'
	option key '<FRIEND_WIFI_PASSWORD>'
	option disabled '0'
